name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: 语法检查
        run: node --check game.js
      - name: 回归测试
        run: node scripts/run_all_tests.js
      - name: 数值模拟可运行
        run: node scripts/sim_v22_real.js > /dev/null
